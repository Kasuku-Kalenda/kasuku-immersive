# ─── Kasuku Immersive — Variables d'environnement ────────────────────────────
# Copier ce fichier en .env.local pour le dev, ou injecter via docker-compose

# Base path (vide en dev local, /immersive en Docker derrière nginx)
NEXT_PUBLIC_BASE_PATH=

# URL de base pour les fetch côté serveur (SSR)
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=kasuku
DB_PASSWORD=
DB_NAME=kasuku_db
